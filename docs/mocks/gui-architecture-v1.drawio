        <!-- SECONDARY PANELS -->
        <mxCell id="sec-title" value="🔷 SECONDARY PANELS (Left &amp; Right Sidebars)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;fontSize=12;fontStyle=bold;align=left;padding=8;" vertex="1" parent="1">
          <mxGeometry x="10" y="60" width="1380" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="sec-desc" value="PURPOSE: Dev tools, settings, global overview
LOCATION: Fixed left/right sidebars (outside Canvas)
BEHAVIOR: Can be minimized to tab icons | Overlapped by Canvas when fullscreen | Not part of primary workflow
CONTENT LEFT: Dataset switcher, Contract status, Warnings
CONTENT RIGHT: Quick statistics, Quick notes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#ddd;fontSize=10;align=left;padding=8;" vertex="1" parent="1">
          <mxGeometry x="10" y="95" width="1380" height="100" as="geometry" />

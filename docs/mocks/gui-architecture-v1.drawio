        </mxCell>
        
        <mxCell id="state2" value="MINIMIZED: Secondary panels tabs (⋮) | Primary panels chips (⚙️ ✨ 🔍 📄) | Canvas expanded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#bbb;fontSize=9;align=left;padding=5;" vertex="1" parent="1">
          <mxGeometry x="10" y="440" width="1380" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="state3" value="FULLSCREEN: Secondary panels HIDDEN | Primary panels chips (floating) | Canvas full-width/height | Click chip to expand panel as overlay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#bbb;fontSize=9;align=left;padding=5;" vertex="1" parent="1">
          <mxGeometry x="10" y="470" width="1380" height="25" as="geometry" />
        </mxCell>
        
        <!-- KEY RULES -->
        <mxCell id="rules-title" value="KEY DESIGN RULES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=2;fontSize=12;fontStyle=bold;align=left;padding=8;" vertex="1" parent="1">
          <mxGeometry x="10" y="510" width="1380" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="rules" value="1. Secondary panels are optional (can be minimized/hidden)
2. Primary panels are NEVER fully hidden (minimum: small chip button)
3. Primary panels are always interactive from Canvas, never require secondary sidebars
4. Secondary panels provide dev/meta info, not core workflow
5. Fullscreen mode prioritizes Canvas but keeps primary workflow controls accessible" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#ddd;fontSize=9;align=left;padding=8;" vertex="1" parent="1">

          <mxGeometry x="10" y="380" width="1380" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="state1" value="STANDARD: Secondary panels visible (L+R) | Primary panels expanded (full) | Canvas squeezed between" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#bbb;fontSize=9;align=left;padding=5;" vertex="1" parent="1">
